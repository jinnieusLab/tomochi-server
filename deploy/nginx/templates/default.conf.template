# nginx 이미지가 시작할 때 ${DOMAIN} 같은 환경 변수를 채워 conf.d/default.conf로 만들어요.

# 접속 기록에는 쿼리 문자열을 남기지 않아요.
# 로그인 콜백(?code=&state=)의 1회용 코드가 로그 파일에 쌓이지 않게 해요.
log_format tomochi '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent $request_time';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log tomochi;

    # Let's Encrypt 인증서 발급·갱신 확인용
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    access_log /var/log/nginx/access.log tomochi;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 1m;

    # Actuator는 밖에서 막고 서버 안에서만 봐요 (OPS-2).
    location /actuator {
        return 404;
    }

    location / {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket(/api/v1/ws) 연결을 그대로 넘겨요 (RT-1).
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 75s;
    }
}
