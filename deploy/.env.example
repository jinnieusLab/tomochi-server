# VPS의 deploy 폴더에 .env로 복사해서 채워요. 이 파일만 커밋하고 .env는 커밋하지 않아요.
DOMAIN=dev-api.example.com
CERTBOT_EMAIL=you@example.com

DB_NAME=tomochi
DB_USERNAME=tomochi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT 서명 키 (HS256). openssl rand -base64 48 로 만들어요. 로컬과 다른 값을 써요.
JWT_SECRET=

# 소셜 로그인. Dev 도메인용 OAuth 앱을 따로 만들어요 (docs/oauth.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Grafana 관리자 비밀번호 (SSH 터널로만 접속)
GRAFANA_ADMIN_PASSWORD=

# 배포 스크립트가 넣어요. 손으로 띄울 때만 바꿔요.
IMAGE_TAG=dev
