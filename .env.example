# 로컬 실행용 환경 변수 예시예요. 복사해서 .env로 쓰고, .env는 커밋하지 않아요.
# 비밀값(DB 비밀번호, JWT 키, OAuth 시크릿)은 기능이 생길 때 여기에 키 이름만 추가해요.
SERVER_PORT=8080

# MySQL (docker-compose.yml). 로컬에 설치된 MySQL과 겹치지 않게 3307을 써요.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=tomochi
DB_USERNAME=tomochi
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Redis (docker-compose.yml). 로컬에 설치된 Redis와 겹치지 않게 6380을 써요.
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT 서명 키 (HS256). openssl rand -base64 48 로 만들어요.
JWT_SECRET=

# 소셜 로그인 (docs/oauth.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
