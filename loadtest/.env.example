# 부하 테스트용 값이에요. 복사해서 loadtest/.env로 쓰고, .env는 커밋하지 않아요.
# 운영·Dev와 다른 값을 쓰세요. 특히 JWT_SECRET은 k6가 토큰을 서명할 때도 써요.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# openssl rand -base64 48
JWT_SECRET=

# VPS 사양 흉내 (기본 2코어·2GB를 나눠 가짐)
# APP_CPUS=1.0
# APP_MEM=1g
# MYSQL_CPUS=0.7
# MYSQL_MEM=768m
# REDIS_CPUS=0.3
# REDIS_MEM=256m
